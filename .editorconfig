root = true

[*.cs]
indent_style = tab
indent_size = tab
tab_width = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped

# State accessibility explicitly on types and members.
dotnet_style_require_accessibility_modifiers = always
dotnet_diagnostic.IDE0040.severity = warning

# Braces are required even around a single statement.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# Long lines are acceptable; this is an editor guide, not a compiler limit.
max_line_length = 240

# Declare the type explicitly, including when the initializer makes it obvious.
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false
dotnet_diagnostic.IDE0008.severity = warning

# Use target-typed new() when the destination type is apparent.
csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_diagnostic.IDE0090.severity = warning

# Do not suggest primary constructors for classes or structs. This does not
# diagnose existing primary constructors; the record-only rule needs review
# guidance or a separate analyzer.
csharp_style_prefer_primary_constructors = false
dotnet_diagnostic.IDE0290.severity = none

# Flag methods with high cyclomatic complexity.
dotnet_diagnostic.CA1502.severity = warning

# Requires StyleCop.Analyzers in the consuming project. Its default setting
# only covers some type kinds; strict one-type-per-file also needs stylecop.json.
dotnet_diagnostic.SA1402.severity = warning

# Standard C# identifier casing.
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_symbols.members.applicable_kinds = property, method, event, local_function
dotnet_naming_symbols.members.applicable_accessibilities = *
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case
dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.private_field_camel_case.capitalization = camel_case
dotnet_naming_style.private_field_camel_case.required_prefix = _
dotnet_naming_style.type_parameter_pascal_case.capitalization = pascal_case
dotnet_naming_style.type_parameter_pascal_case.required_prefix = T

dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_pascal_case
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal_case
dotnet_naming_rule.types.severity = warning
dotnet_naming_rule.members.symbols = members
dotnet_naming_rule.members.style = pascal_case
dotnet_naming_rule.members.severity = warning
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = private_field_camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal_case
dotnet_naming_rule.constants.severity = warning
dotnet_naming_rule.locals_and_parameters.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters.style = camel_case
dotnet_naming_rule.locals_and_parameters.severity = warning
dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = type_parameter_pascal_case
dotnet_naming_rule.type_parameters.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Keep analyzer warnings out of generated source.
[*.g.cs]
generated_code = true

[*.g.i.cs]
generated_code = true

[*.generated.cs]
generated_code = true

[*.designer.cs]
generated_code = true

[*.Designer.cs]
generated_code = true
