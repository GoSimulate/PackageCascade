<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
        <!-- In-process MSBuild loads assemblies from disk, so the bundle must extract all content. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="PackageCascade.Cli.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PackageCascade\PackageCascade.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
      <PackageReference Include="System.CommandLine" Version="2.0.14" />
    </ItemGroup>

</Project>
