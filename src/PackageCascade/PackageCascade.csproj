<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Authors>GoSim</Authors>
    <Description>Plan releases for solutions containing packable .NET projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GoSimulate/PackageCascade</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PackageCascade.Tests.Unit" />
    <PackageReference Include="ArchonAnalysers" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
